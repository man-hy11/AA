        <mxCell id="CeyNviYJrikVbIxdHnzS-1" parent="CeyNviYJrikVbIxdHnzS-0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n\n%% =========================================================\n%% CLIENTS / ACTORS\n%% =========================================================\nsubgraph CLIENTS[\&quot;CLIENTS / ACTORS\&quot;]\n\n    UserApp[\&quot;&lt;&lt;comp&gt;&gt; User App&lt;br/&gt;\n    - 지역 상품권 구매&lt;br/&gt;\n    - 지역 선택 및 정책 기반 구매&lt;br/&gt;\n    - 현재 잔액 조회&lt;br/&gt;\n    - 추가 구매 / 환불&lt;br/&gt;\n    - 위치 기반 가맹점 검색&lt;br/&gt;\n    - 키워드 + 거리순 검색&lt;br/&gt;\n    - 추천 가맹점 검색&lt;br/&gt;\n    - 특정 가맹점 상세 / 위치 조회&lt;br/&gt;\n    - 상품권 결제 요청\&quot;]\n\n    MerchantApp[\&quot;&lt;&lt;comp&gt;&gt; Merchant App&lt;br/&gt;\n    - 5초 주기 영업상태 전송&lt;br/&gt;\n    - 결제 승인 실시간 알림 수신&lt;br/&gt;\n    - 결제 금액 오류 시 결제 취소\&quot;]\n\n    AdminPortal[\&quot;&lt;&lt;comp&gt;&gt; Admin Portal&lt;br/&gt;\n    - 지역 정책 설정&lt;br/&gt;\n    - 지역 예산 설정&lt;br/&gt;\n    - 가맹점 심사 / 승인 / 관리&lt;br/&gt;\n    - 공지 등록&lt;br/&gt;\n    - 통계 / 리포트 조회\&quot;]\n\nend\n\n\n%% =========================================================\n%% PLATFORM\n%% =========================================================\nsubgraph PLATFORM[\&quot;PLATFORM BOUNDARY\&quot;]\n\n    EventBus[\&quot;&lt;&lt;comp&gt;&gt; EventBus&lt;br/&gt;\n    - IEventPublisher&lt;br/&gt;\n    - IEventSubscriber&lt;br/&gt;\n    - Buffered Message / Pub-Sub\&quot;]\n\n    AdminSys[\&quot;&lt;&lt;comp&gt;&gt; Admin System&lt;br/&gt;\n    (IAdmin)&lt;br/&gt;\n    - PolicyBudgetManager&lt;br/&gt;\n    - MerchantApprovalModule&lt;br/&gt;\n    - NoticeConfigManager&lt;br/&gt;\n    - AuditLogReportEngine\&quot;]\n\n    VoucherSys[\&quot;&lt;&lt;comp&gt;&gt; Voucher System&lt;br/&gt;\n    (IVoucher)&lt;br/&gt;\n    - RegionPolicyValidator&lt;br/&gt;\n    - PurchaseModule&lt;br/&gt;\n    - RefundModule&lt;br/&gt;\n    - BalanceManager\&quot;]\n\n    MerchantSys[\&quot;&lt;&lt;comp&gt;&gt; Merchant System&lt;br/&gt;\n    (IMerchant)&lt;br/&gt;\n    - MerchantStatusReceiver&lt;br/&gt;\n    - MerchantInfoManager&lt;br/&gt;\n    - MerchantAvailabilityManager&lt;br/&gt;\n    - MerchantApprovalStatusManager\&quot;]\n\n    SearchSys[\&quot;&lt;&lt;comp&gt;&gt; Search / Recommendation System&lt;br/&gt;\n    (ISearch)&lt;br/&gt;\n    - GeoSearchModule&lt;br/&gt;\n    - KeywordDistanceSearchModule&lt;br/&gt;\n    - MerchantDetailModule&lt;br/&gt;\n    - BusinessStatusFilter&lt;br/&gt;\n    - HistoryRecommendationEngine\&quot;]\n\n    PaymentSys[\&quot;&lt;&lt;comp&gt;&gt; Payment System&lt;br/&gt;\n    (IPayment)&lt;br/&gt;\n    - UserPaymentProcessor&lt;br/&gt;\n    - MerchantValidator&lt;br/&gt;\n    - BalanceChecker&lt;br/&gt;\n    - MerchantCancelProcessor&lt;br/&gt;\n    - SettlementManager\&quot;]\n\n    FinAdapter[\&quot;&lt;&lt;comp&gt;&gt; Financial Adapter&lt;br/&gt;\n    (IFinancial)&lt;br/&gt;\n    - BankAdapter&lt;br/&gt;\n    - CardAdapter\&quot;]\n\n    DBManager[\&quot;&lt;&lt;comp&gt;&gt; DBManager&lt;br/&gt;\n    - RDB&lt;br/&gt;\n    - Redis\&quot;]\n\nend\n\n\n%% =========================================================\n%% EXTERNAL SYSTEM\n%% =========================================================\nsubgraph EXTERNAL[\&quot;EXTERNAL SYSTEM\&quot;]\n\n    FinSystem[\&quot;&lt;&lt;comp&gt;&gt; Financial System&lt;br/&gt;\n    Bank / Card Company\&quot;]\n\nend\n\n\n%% =========================================================\n%% USER APP -&gt; PLATFORM\n%% =========================================================\n\nUserApp --&gt;|\&quot;voucherRequest&lt;br/&gt;\n구매 / 추가구매 / 환불 / 잔액조회&lt;br/&gt;\nREST / HTTPS\&quot;| VoucherSys\n\nUserApp --&gt;|\&quot;searchRequest&lt;br/&gt;\n위치 / 키워드 / 추천 / 상세조회&lt;br/&gt;\nREST / HTTPS\&quot;| SearchSys\n\nUserApp --&gt;|\&quot;paymentRequest&lt;br/&gt;\n상품권 결제 요청&lt;br/&gt;\nREST / HTTPS\&quot;| PaymentSys\n\n\n%% =========================================================\n%% MERCHANT APP -&gt; PLATFORM\n%% =========================================================\n\nMerchantApp --&gt;|\&quot;merchantRequest&lt;br/&gt;\n가맹점 정보 조회 / 관리&lt;br/&gt;\nREST / HTTPS\&quot;| MerchantSys\n\nMerchantApp --&gt;|\&quot;merchantStatus&lt;br/&gt;\n5초 주기 영업상태 전송&lt;br/&gt;\nREST / HTTPS\&quot;| MerchantSys\n\nMerchantApp --&gt;|\&quot;cancelPayment&lt;br/&gt;\n결제 취소 요청&lt;br/&gt;\nREST / HTTPS\&quot;| PaymentSys\n\nPaymentSys --&gt;|\&quot;paymentNotification&lt;br/&gt;\n결제 승인 / 취소 실시간 알림&lt;br/&gt;\nSSE / WebSocket\&quot;| MerchantApp\n\n\n%% =========================================================\n%% ADMIN PORTAL\n%% =========================================================\n\nAdminPortal --&gt;|\&quot;adminRequest&lt;br/&gt;\nREST / HTTPS\&quot;| AdminSys\n\n\n%% =========================================================\n%% ADMIN SYSTEM\n%% =========================================================\n\nAdminSys --&gt;|\&quot;IVoucher&lt;br/&gt;\n지역 정책 / 예산 동기화\&quot;| VoucherSys\n\nAdminSys --&gt;|\&quot;IMerchant&lt;br/&gt;\n가맹점 심사 / 승인 결과\&quot;| MerchantSys\n\nAdminSys --&gt;|\&quot;IPayment&lt;br/&gt;\n결제 / 정산 / 통계 조회\&quot;| PaymentSys\n\nAdminSys --&gt;|\&quot;publisher&lt;br/&gt;\nPolicyChanged&lt;br/&gt;\nBudgetChanged&lt;br/&gt;\nNoticeChanged&lt;br/&gt;\nConfigChanged\&quot;| EventBus\n\n\n%% =========================================================\n%% VOUCHER SYSTEM\n%% =========================================================\n\nVoucherSys --&gt;|\&quot;requires IFinancial&lt;br/&gt;\n상품권 구매 / 환불 금융 처리\&quot;| FinAdapter\n\nVoucherSys --&gt;|\&quot;publisher&lt;br/&gt;\nVoucherPurchased&lt;br/&gt;\nVoucherRefunded&lt;br/&gt;\nBalanceChanged\&quot;| EventBus\n\n\n%% =========================================================\n%% MERCHANT SYSTEM\n%% =========================================================\n\nMerchantSys --&gt;|\&quot;publisher&lt;br/&gt;\nMerchantStatusChanged&lt;br/&gt;\n5초 영업상태 업데이트\&quot;| EventBus\n\nMerchantSys --&gt;|\&quot;publisher&lt;br/&gt;\nMerchantApproved&lt;br/&gt;\nMerchantUpdated\&quot;| EventBus\n\n\n%% =========================================================\n%% EVENT BUS -&gt; SUBSCRIBERS\n%% =========================================================\n\nEventBus --&gt;|\&quot;subscriber&lt;br/&gt;\nPolicyChanged / BudgetChanged\&quot;| VoucherSys\n\nEventBus --&gt;|\&quot;subscriber&lt;br/&gt;\nMerchantStatusChanged\&quot;| SearchSys\n\nEventBus --&gt;|\&quot;subscriber&lt;br/&gt;\nMerchantApproved / MerchantUpdated\&quot;| SearchSys\n\nEventBus --&gt;|\&quot;subscriber&lt;br/&gt;\nPaymentApproved&lt;br/&gt;\nPaymentCancelled&lt;br/&gt;\n구매이력 데이터\&quot;| SearchSys\n\n\n%% =========================================================\n%% SEARCH / RECOMMENDATION SYSTEM\n%% =========================================================\n\nSearchSys --&gt;|\&quot;requires IMerchant&lt;br/&gt;\n가맹점 정보 / 위치 / 승인상태 조회\&quot;| MerchantSys\n\n\n%% =========================================================\n%% PAYMENT SYSTEM\n%% =========================================================\n\nPaymentSys --&gt;|\&quot;requires IMerchant&lt;br/&gt;\nMerchantValidator&lt;br/&gt;\n가맹점 여부 / 승인상태 검증\&quot;| MerchantSys\n\nPaymentSys --&gt;|\&quot;requires IVoucher&lt;br/&gt;\nBalanceChecker&lt;br/&gt;\n잔액 확인 / 차감 / 복구\&quot;| VoucherSys\n\nPaymentSys --&gt;|\&quot;requires IFinancial&lt;br/&gt;\nSettlement / Financial Request\&quot;| FinAdapter\n\nPaymentSys --&gt;|\&quot;publisher&lt;br/&gt;\nPaymentApproved&lt;br/&gt;\nPaymentCancelled&lt;br/&gt;\nPaymentFailed\&quot;| EventBus\n\n\n%% =========================================================\n%% FINANCIAL SYSTEM\n%% =========================================================\n\nFinAdapter --&gt;|\&quot;financialRequest&lt;br/&gt;\n구매 / 환불 / 정산 요청&lt;br/&gt;\nmTLS / Dedicated Line\&quot;| FinSystem\n\nFinSystem --&gt;|\&quot;financialResponse&lt;br/&gt;\n승인 / 실패 결과&lt;br/&gt;\nmTLS / Dedicated Line\&quot;| FinAdapter\n\n\n%% =========================================================\n%% DATABASE CONNECTIONS\n%% =========================================================\n\nAdminSys --&gt;|\&quot;Policy / Budget / Admin / Audit Data\&quot;| DBManager\n\nVoucherSys --&gt;|\&quot;Voucher / Balance / Purchase / Refund Data\&quot;| DBManager\n\nMerchantSys --&gt;|\&quot;Merchant / Approval / Status Data\&quot;| DBManager\n\nSearchSys --&gt;|\&quot;Search Index / Recommendation / Cache\&quot;| DBManager\n\nPaymentSys --&gt;|\&quot;Payment / Cancel / Settlement History\&quot;| DBManager\n\nFinAdapter --&gt;|\&quot;Financial Transaction Log\&quot;| DBManager\n\n\n%% =========================================================\n%% STYLE\n%% =========================================================\n\nstyle UserApp fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px\nstyle MerchantApp fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px\nstyle AdminPortal fill:#dae8fc,stroke:#6c8ebf,stroke-width:1px\n\nstyle EventBus fill:#e1d5e7,stroke:#9673a6,stroke-width:1px\n\nstyle AdminSys fill:#d5e8d4,stroke:#82b366,stroke-width:1px\nstyle VoucherSys fill:#d5e8d4,stroke:#82b366,stroke-width:1px\nstyle MerchantSys fill:#d5e8d4,stroke:#82b366,stroke-width:1px\nstyle SearchSys fill:#d5e8d4,stroke:#82b366,stroke-width:1px\nstyle FinAdapter fill:#d5e8d4,stroke:#82b366,stroke-width:1px\n\nstyle PaymentSys fill:#fff2cc,stroke:#d6b656,stroke-width:1px\n\nstyle DBManager fill:#e3d8f1,stroke:#b8a1d9,stroke-width:1px\n\nstyle FinSystem fill:#f8cecc,stroke:#b85450,stroke-width:1px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="HCBr4GNnQ7bQFWIoBG1G-78">
